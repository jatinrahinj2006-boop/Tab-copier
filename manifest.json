{
  "manifest_version": 3,
  "name": "Tab Link Copier",
  "description": "Copy URLs from selected/grouped tabs — plain, Markdown, JSON, CSV, HTML, .docx.",
  "version": "1.1",
  "incognito": "spanning",
  "permissions": [
    "tabs",
    "contextMenus",
    "scripting",
    "clipboardWrite",
    "storage",
    "alarms",
    "tabGroups",
    "downloads"
  ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Tab Link Copier",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "commands": {
    "copy-selected-tabs": {
      "suggested_key": {
        "default": "Alt+Shift+C",
        "mac": "Command+Shift+C"
      },
      "description": "Copy links of selected tabs"
    },
    "copy-and-close-selected": {
      "suggested_key": {
        "default": "Alt+Shift+X",
        "mac": "Command+Shift+X"
      },
      "description": "Copy and close selected tabs"
    }
  }
}
